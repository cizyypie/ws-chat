<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Room: <%= room %> - Chat API</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="centered-layout">
    <div class="chat-container">
        <div class="chat-header">
            <h2># <%= room %></h2>
            <a href="/rooms" class="leave-btn">Back to Rooms</a>
        </div>
        
        <div class="chat-messages" id="messages">
            <div class="message system">Chat room ready. WebSocket coming in Phase 5...</div>
        </div>
        
        <form class="chat-input" id="messageForm">
            <input 
                type="text" 
                id="messageInput" 
                placeholder="Type a message..." 
                required 
                autocomplete="off"
                disabled>
            <button type="submit" disabled>Send</button>
        </form>
    </div>

    <script>
        const userId = "<%= userId %>";
        const roomName = "<%= room %>";
        
        console.log('Chat page ready for room:', roomName);
        console.log('User ID:', userId);
        
        const messageForm = document.getElementById('messageForm');
        const messageInput = document.getElementById('messageInput');
        
        messageForm.addEventListener('submit', (e) => {
            e.preventDefault();
            console.log('WebSocket not implemented yet!');
            alert('Chat coming soon! Phase 5: WebSocket Implementation');
        });
    </script>
</body>
</html>