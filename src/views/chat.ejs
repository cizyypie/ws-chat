<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Room: <%= room %> - Chat API</title>
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body class="centered-layout">
    <div class="chat-container">
      <div class="chat-header">
        <h2># <%= room %></h2>
        <div style="display: flex; gap: 1rem; align-items: center">
      
          <!-- Three dots menu -->
          <div style="position: relative">
            <button
              id="menuBtn"
              style="
                background: none;
                border: none;
                color: white;
                cursor: pointer;
                font-size: 1.5rem;
              "
            >
              ⋯
            </button>
            <div
              id="menu"
              style="
                display: none;
                position: absolute;
                top: 100%;
                right: 0;
                background: white;
                border: 1px solid #ccc;
                border-radius: 4px;
                min-width: 150px;
                box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
                z-index: 10;
              "
            >
              <button
                id="leaveRoomBtn"
                style="
                  display: block;
                  width: 100%;
                  padding: 10px 15px;
                  border: none;
                  background: none;
                  cursor: pointer;
                  text-align: left;
                  color: #dc2626;
                  font-weight: 500;
                  border-bottom: 1px solid #eee;
                "
              >
                Leave Room
              </button>
              <a
                href="/rooms"
                style="
                  display: block;
                  padding: 10px 15px;
                  color: #6b7280;
                  text-decoration: none;
                "
                >Back to Rooms</a
              >
            </div>
          </div>
        </div>
      </div>

      <div class="chat-messages" id="messages">
        <div class="message system">Connecting to room...</div>
      </div>

      <form class="chat-input" id="messageForm">
        <input
          type="text"
          id="messageInput"
          placeholder="Type a message..."
          required
          autocomplete="off"
        />
        <button type="submit">Send</button>
      </form>
    </div>

    <script>
      // Chat Client
      class ChatClient {
        constructor(userId, username, roomName, roomId) {
          this.userId = userId;
          this.username = username;
          this.roomName = roomName;
          this.roomId = roomId;
          this.ws = null;

          // DOM elements
          this.messagesDiv = document.getElementById("messages");
          this.messageForm = document.getElementById("messageForm");
          this.messageInput = document.getElementById("messageInput");

          console.log("Chat initialized:", {
            userId: this.userId,
            username: this.username,
            roomId: this.roomId,
          });

          this.connect();
        }

        connect() {
          const protocol =
            window.location.protocol === "https:" ? "wss:" : "ws:";
          const wsUrl = `${protocol}//${window.location.host}/ws`;

          console.log("🔗 Connecting to WebSocket:", wsUrl);

          this.ws = new WebSocket(wsUrl);

          this.ws.onopen = () => {
            console.log("WebSocket connected!");
            this.messagesDiv.innerHTML = "";
            this.showSystemMessage("Connected! Joining room...");
            this.joinRoom();
          };

          this.ws.onmessage = (event) => {
            try {
              const data = JSON.parse(event.data);
              console.log("Received:", data.type);
              this.handleMessage(data);
            } catch (error) {
              console.error("Error parsing message:", error);
            }
          };

          this.ws.onclose = () => {
            console.log("WebSocket disconnected");
            this.showSystemMessage("Disconnected from server.");
            this.messageInput.disabled = true;
          };

          this.ws.onerror = (error) => {
            console.error("WebSocket error:", error);
            this.showSystemMessage("Connection error!");
          };

          this.messageForm.addEventListener("submit", (e) => {
            e.preventDefault();
            this.sendMessage();
          });
        }

        joinRoom() {
          console.log("Sending join message...");
          this.ws.send(
            JSON.stringify({
              type: "join",
              userId: this.userId,
              roomId: this.roomId,
              username: this.username,
            }),
          );
        }

        handleMessage(data) {
          switch (data.type) {
            case "joined":
              console.log("Joined room!");

              if (data.history && Array.isArray(data.history)) {
                console.log("Loading", data.history.length, "past messages");
                data.history.forEach((msg) => {
                  const isOwn = parseInt(msg.userId) === parseInt(this.userId);
                  this.displayMessage({
                    id: msg.id,
                    username: msg.username,
                    content: msg.content,
                    createdAt: msg.createdAt,
                    isOwn: isOwn,
                  });
                });
              }
              break;

            case "message":
              console.log("💬 New message from", data.username);
              this.displayMessage(data);
              break;

            case "user_joined":
              this.showSystemMessage(
                `${data.username} joined`,
              );
            case "user_left":
              this.showSystemMessage(
                `${data.username} left`,
              );
            case "message_edited":
              this.editMessageDisplay(data.messageId, data.content);
              break;

            case "message_deleted":
              this.deleteMessageDisplay(data.messageId);
              break;

            case "error":
              console.error("Server error:", data.message);
              this.showSystemMessage(`Error: ${data.message}`);
              break;

            default:
              console.warn("Unknown message type:", data.type);
          }
        }

        sendMessage() {
          const content = this.messageInput.value.trim();

          if (
            !content ||
            !this.roomId ||
            !this.ws ||
            this.ws.readyState !== WebSocket.OPEN
          ) {
            return;
          }

          const message = {
            type: "message",
            userId: this.userId,
            roomId: this.roomId,
            username: this.username,
            content,
          };

          console.log("📤 Sending message:", message);
          this.ws.send(JSON.stringify(message));

          this.displayMessage({
            username: this.username,
            content,
            createdAt: new Date().toISOString(),
            isOwn: true,
          });

          this.messageInput.value = "";
          this.messageInput.focus();
        }

        displayMessage(data) {
          const msgDiv = document.createElement("div");
          msgDiv.className = `message ${data.isOwn ? "self" : "other"}`;
          if (data.id) msgDiv.id = `msg-${data.id}`;

          const time = new Date(data.createdAt).toLocaleTimeString();

          if (data.isOwn) {
            msgDiv.innerHTML = `<div>${data.content}</div><small style="opacity: 0.7;">${time}</small>`;
          } else {
            msgDiv.innerHTML = `
                        <div class="message-header">${data.username} ${time}</div>
                        <div>${data.content}</div>
                    `;
          }

          this.messagesDiv.appendChild(msgDiv);
          this.messagesDiv.scrollTop = this.messagesDiv.scrollHeight;
        }

        showSystemMessage(text) {
          const msgDiv = document.createElement("div");
          msgDiv.className = "message system";
          msgDiv.textContent = text;
          this.messagesDiv.appendChild(msgDiv);
          this.messagesDiv.scrollTop = this.messagesDiv.scrollHeight;
        }

        editMessageDisplay(messageId, newContent) {
          const el = document.getElementById(`msg-${messageId}`);
          if (el) {
            el.textContent = newContent + " (edited)";
          }
        }

        deleteMessageDisplay(messageId) {
          const el = document.getElementById(`msg-${messageId}`);
          if (el) {
            el.textContent = "[Message deleted]";
            el.style.opacity = "0.5";
          }
        }

        disconnectTemporarily() {
          console.log("Temporarily disconnecting...");
          if (this.ws && this.ws.readyState === WebSocket.OPEN) {
            // Send disconnect message (NOT leave!)
            this.ws.send(
              JSON.stringify({
                type: "disconnect",
                userId: this.userId,
                roomId: this.roomId,
                username: this.username,
              }),
            );
            this.ws.close();
          }
        }

        async leaveRoomPermanently() {
          console.log("Leaving room...");

          // Step 1: Notify server via WebSocket
          if (this.ws && this.ws.readyState === WebSocket.OPEN) {
            this.ws.send(
              JSON.stringify({
                type: "leave",
                userId: this.userId,
                roomId: this.roomId,
                username: this.username,
              }),
            );
            this.ws.close();
          }

          // Step 2: Remove from database
          try {
            const response = await fetch(`/rooms/${this.roomId}/leave`, {
              method: "POST",
            });
            console.log("Removed from database:", response.ok);
          } catch (error) {
            console.error("Error removing from database:", error);
          }
        }
      }

      // Initialize
      const userId = "<%= userId %>";
      const username = "<%= username || 'Guest' %>";
      const roomName = "<%= room %>";
      const roomId = "<%= roomId %>";

      console.log("🎮 Chat initialized:", {
        userId,
        username,
        roomName,
        roomId,
      });

      const chatClient = new ChatClient(
        userId,
        username,
        roomName,
        parseInt(roomId),
      );

      // Menu Toggle
      const menuBtn = document.getElementById("menuBtn");
      const menu = document.getElementById("menu");
      const leaveRoomBtn = document.getElementById("leaveRoomBtn");

      menuBtn.addEventListener("click", (e) => {
        e.stopPropagation();
        menu.style.display = menu.style.display === "none" ? "block" : "none";
      });

      // Close menu when clicking elsewhere
      document.addEventListener("click", () => {
        menu.style.display = "none";
      });

      // Leave Room Button
      leaveRoomBtn.addEventListener("click", async (e) => {
        e.preventDefault();
        if (confirm("Are you sure you want to leave this room?")) {
          await chatClient.leaveRoomPermanently();
          // Redirect after a short delay
          setTimeout(() => {
            window.location.href = "/rooms";
          }, 500);
        }
      });

      // Back to Rooms (via menu)
      const backToRoomsLink = document.querySelector('a[href="/rooms"]');
      backToRoomsLink.addEventListener("click", (e) => {
        e.preventDefault();
        chatClient.disconnectTemporarily();
        // Then navigate
        setTimeout(() => {
          window.location.href = "/rooms";
        }, 300);
      });

      // Cleanup on page unload
      window.addEventListener("beforeunload", () => {
        chatClient.disconnectTemporarily();
      });

      // Make available globally for debugging
      window.chatClient = chatClient;
    </script>
  </body>
</html>
