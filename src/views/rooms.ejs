<!-- src/views/rooms.ejs -->
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Room Dashboard - Chat API</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="dashboard-layout">
    <div class="container">
        <div class="header">
            <h1>Welcome, <%= username %>!</h1>
            <a href="/logout" class="logout-btn">Logout</a>
        </div>

        <div class="grid">
            <!-- Your Rooms -->
            <div>
                <h2>Your Rooms</h2>
                <div class="room-list">
                    <% if (locals.userRooms && userRooms.length > 0) { %>
                        <% userRooms.forEach(function(room) { %>
                            <a href="/chat?room=<%= room.name %>" class="room-card">
                                <span class="room-name"># <%= room.name %></span>
                                <span class="badge-enter">Enter</span>
                            </a>
                        <% }); %>
                    <% } else { %>
                        <div class="empty-state">You haven't joined any rooms yet.</div>
                    <% } %>
                </div>
            </div>

            <!-- Available Rooms Section -->
            <div>
                <h2>Available Rooms</h2>
                <div class="room-list">
                    <% if (locals.availableRooms && availableRooms.length > 0) { %>
                        <% availableRooms.forEach(function(room) { %>
                            <div class="room-card">
                                <span class="room-name"># <%= room.name %></span>
                                <form action="/rooms/<%= room.id %>/join" method="POST" style="margin: 0;">
                                    <button type="submit" class="badge-join" style="border: none; cursor: pointer;">
                                        Join & Enter
                                    </button>
                                </form>
                            </div>
                        <% }); %>
                    <% } %>
                </div>
            </div>src/routes/room.routes.ts src/routes/auth.routes.ts src/views/rooms.ejs src/db/index.ts
        </div>

        <!-- Create Room - SIMPLE FORM (NO JAVASCRIPT!) -->
        <div class="create-room-section">
            <h2 style="margin-top: 0;">Create a New Room</h2>
            <form action="/rooms" method="POST">
                <div class="form-group">
                    <label for="roomName">Room Name</label>
                    <div class="input-group">
                        <input 
                            type="text" 
                            id="roomName" 
                            name="name" 
                            placeholder="e.g., project-alpha" 
                            required 
                            pattern="[a-zA-Z0-9-]+"
                            title="Only use letters, numbers, and hyphens">
                        <button type="submit">Create</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</body>
</html>